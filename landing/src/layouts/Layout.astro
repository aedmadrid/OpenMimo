---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OpenMimo: Scheduling Software alternativo a Mimosa',
  description = 'OpenMimo es el sucesor espiritual libre (GNU GPLv3) y experimental de Mimosa Scheduling Software, compatible con archivos .mfw y .mxt, con nuevo diseño, MCP y edición colaborativa. Una iniciativa de la Asociación de Estudiantes de Diseño de Madrid (aedm.org.es) para que la Escuela Superior de Diseño de Madrid actualice su software a uno más moderno de manera simple.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}logo.svg`} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f6f8fb;
        --surface: #ffffff;
        --ink: #0f172a;
        --muted: #475569;
        --faint: #64748b;
        --border: #e2e8f0;
        --blue: #2563eb;
        --indigo: #6366f1;
        --emerald: #059669;
        --amber: #d97706;
        --teal: #0d9488;
        --rose: #e11d48;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        line-height: 1.55;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

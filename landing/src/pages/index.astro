---
import Layout from '../layouts/Layout.astro';

const REPO_URL = 'https://github.com/aedmadrid/openmimo';
const RELEASES_URL = 'https://github.com/aedmadrid/openmimo/releases/latest';
const AEDM_URL = 'https://aedm.org.es';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Exact replica of OpenMimo's toolbar order and studio colors
const studios = [
  { id: 'resources', label: 'Recursos', color: '#2563eb', src: `${base}shots/resources.png`, alt: 'Recursos: grupos, profesorado con importación CSV, aulas y bloqueos de disponibilidad' },
  { id: 'courses', label: 'Sesiones', color: '#ea580c', src: `${base}shots/courses.png`, alt: 'Sesiones: cursos, colecciones, asignaturas globales y horas seguidas mínimas/máximas' },
  { id: 'weeks', label: 'Semanas', color: '#9333ea', src: `${base}shots/weeks.png`, alt: 'Semanas: distribución multi-semana y carga semanal por recurso' },
  { id: 'timetables', label: 'Horarios', color: '#059669', src: `${base}shots/timetables.png`, alt: 'Horarios: rejilla interactiva con huecos disponibles y mini-horarios vinculados' },
  { id: 'guides', label: 'Guías', color: '#0284c7', src: `${base}shots/guides.png`, alt: 'Guías Docentes: editor colaborativo con exportación estática a Astro' },
  { id: 'scripts', label: 'Scripts', color: '#e11d48', src: `${base}shots/scripts.png`, alt: 'Scripts: librería JavaScript con consola de depuración y generación con IA' },
];

const features = [
  {
    badge: 'Sucesor espiritual libre',
    title: 'Abre tus archivos antiguos de Mimosa sin perder nada',
    text: 'Mimosa desapareció y dejó de recibir mantenimiento. OpenMimo —sin afiliación alguna con Mimosa— abre directamente ficheros heredados (.mfw y .mxt) sin límites y guarda en formato abierto .omimo.',
  },
  {
    badge: 'Nuevo diseño',
    title: 'Interfaz moderna, clara y fiel al flujo real',
    text: 'Seis espacios de trabajo en el mismo orden lógico (Recursos, Sesiones, Semanas, Horarios, Guías y Scripts), con menú contextual propio y menús nativos del sistema.',
  },
  {
    badge: 'MCP integrado',
    title: 'Compatible con cualquier Agente IA vía MCP',
    text: 'Servidor MCP JSON-RPC 2.0 (stdio y HTTP) con 20 herramientas para gestionar horarios, recursos, restricciones, guías docentes y scripts desde cualquier agente.',
  },
  {
    badge: 'Edición colaborativa',
    title: 'Tiempo real e IPFS para equipos y docentes',
    text: 'Comparte un proyecto con un código para que varios coordinadores o profesores editen horarios y guías docentes a la vez mientras el equipo anfitrión lo mantiene abierto.',
  },
  {
    badge: 'Automejora + Scripts IA',
    title: 'Optimización multi-pasada y automatización',
    text: 'Motor de automejora con mínimo y máximo de horas seguidas por curso, además de librería de scripts programables o generables con tu propia API Key estilo OpenAI en Ajustes.',
  },
  {
    badge: 'FOSS · GNU GPLv3',
    title: 'Software libre y proyecto experimental abierto',
    text: '100 % código abierto bajo licencia GNU GPLv3, sin versiones de pago ni bloqueos. Se encuentra en fase experimental activa: revisa siempre tus horarios antes de publicarlos.',
  },
];
---

<Layout title="OpenMimo: Scheduling Software alternativo a Mimosa">
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" class="brand">
        <img src={`${base}logo.svg`} alt="OpenMimo" width="32" height="32" class="brand-icon" />
        <span>OpenMimo</span>
        <span class="exp-tag">Experimental</span>
      </a>
      <nav class="nav-links">
        <a href="#capturas">Capturas</a>
        <a href="#funciones">Funciones</a>
        <a href="#iniciativa">Iniciativa</a>
        <a href="#descargar">Descargar</a>
        <a href={REPO_URL} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary">
        Descargar
      </a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="badges-row">
          <span class="pill-badge">FOSS · GNU GPLv3</span>
          <span class="pill-badge warn">Software Experimental</span>
          <span class="pill-badge neutral">Compatible con .mfw y .mxt</span>
        </div>

        <h1>El sucesor espiritual libre de Mimosa<br />para horarios y guías docentes.</h1>
        <p class="hero-sub">
          Mimosa ya no existe ni se actualiza. <strong>OpenMimo</strong> es una alternativa independiente de código abierto
          (no afiliada con Mimosa) compatible con la apertura de archivos antiguos de Mimosa, con nuevo diseño,
          servidor <strong>MCP</strong>, <strong>edición colaborativa</strong> y guías docentes exportables a Astro.
        </p>

        <div class="hero-actions">
          <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary btn-lg">
            Descargar para macOS, Windows y Linux
          </a>
          <a href={REPO_URL} target="_blank" rel="noreferrer" class="btn btn-outline btn-lg">
            Ver repositorio en GitHub
          </a>
        </div>

        <p class="origin-note">
          Una iniciativa de la <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>Asociación de Estudiantes de Diseño de Madrid (aedm.org.es)</strong></a>
          para que la <strong>Escuela Superior de Diseño de Madrid (ESDMadrid)</strong> actualice su software.
        </p>

        <!-- Centered Studio Tabs + Real App Screenshots + Subtle Autoplay Control Below -->
        <div id="capturas" class="showcase" data-showcase>
          <div class="shot-tabs" role="tablist" aria-label="Apartados de OpenMimo">
            {studios.map((s, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                class={`shot-tab ${idx === 0 ? 'active' : ''}`}
                data-idx={idx}
                data-shot={s.id}
                data-color={s.color}
                style={idx === 0 ? `background:${s.color};color:#fff;` : ''}
              >
                {s.label}
              </button>
            ))}
          </div>

          <div class="shot-frame">
            {studios.map((s, idx) => (
              <img
                src={s.src}
                alt={s.alt}
                data-panel={s.id}
                class={`shot-img ${idx === 0 ? 'active' : ''}`}
                loading={idx === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>

          <div class="autoplay-bar">
            <button type="button" class="autoplay-btn" data-rot-toggle>
              <span class="autoplay-dot" data-rot-dot></span>
              <span data-rot-status>Rotación automática activa · Pausar</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="funciones" class="section section-alt">
      <div class="container">
        <div class="section-head">
          <h2>Diseñado para dar continuidad y futuro a tus horarios</h2>
          <p>Conserva el flujo familiar de Mimosa mientras añade colaboración, agentes MCP, scripts y publicación web moderna.</p>
        </div>
        <div class="features-grid">
          {features.map((f) => (
            <article class="feature-card">
              <span class="feature-badge">{f.badge}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="iniciativa" class="section">
      <div class="container">
        <div class="initiative-card">
          <div>
            <span class="feature-badge">Iniciativa comunitaria · GNU GPLv3</span>
            <h2>Impulsado por la Asociación de Estudiantes de Diseño de Madrid para la ESDMadrid</h2>
            <p>
              Ante la desaparición de Mimosa Scheduling Software, <strong>OpenMimo</strong> nace como su{' '}
              <strong>sucesor espiritual libre</strong> —sin afiliación alguna con Mimosa— impulsado por la{' '}
              <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>Asociación de Estudiantes de Diseño de Madrid (aedm.org.es)</strong></a>{' '}
              para que la <strong>Escuela Superior de Diseño de Madrid (ESDMadrid)</strong>, así como cualquier otro centro educativo,
              pueda actualizar su software de horarios y guías docentes con una herramienta abierta y mantenible bajo licencia{' '}
              <strong>GNU GPLv3</strong>.
            </p>
            <p class="exp-disclaimer">
              <strong>Estado experimental y aviso de no afiliación:</strong> OpenMimo es un proyecto independiente en fase experimental activa y no está afiliado, patrocinado ni respaldado por Mimosa Scheduling Software. Guarda copias en formato <code>.omimo</code> y verifica siempre tus horarios antes de publicarlos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="descargar" class="section section-alt">
      <div class="container">
        <div class="download-box">
          <div>
            <h2>Descarga OpenMimo</h2>
            <p>
              Instaladores para macOS, Windows y Linux (AppImage) con búsqueda automática de nuevas releases en GitHub.
            </p>
          </div>
          <div class="download-actions">
            <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary btn-lg">
              macOS (.dmg)
            </a>
            <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-dark btn-lg">
              Windows (.exe / .msi)
            </a>
            <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-outline btn-lg">
              Linux (.AppImage)
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="brand">
        <img src={`${base}logo.svg`} alt="OpenMimo" width="24" height="24" class="brand-icon" />
        <span>OpenMimo</span>
      </div>
      <p>
        Iniciativa de la <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>Asociación de Estudiantes de Diseño de Madrid (aedm.org.es)</strong></a> ·
        Licencia <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noreferrer"><strong>GNU GPLv3</strong></a> ·
        <a href={REPO_URL} target="_blank" rel="noreferrer">github.com/aedmadrid/openmimo</a>
      </p>
    </div>
  </footer>

  <script>
    const showcase = document.querySelector('[data-showcase]');
    const tabs = Array.from(document.querySelectorAll('.shot-tab')) as HTMLElement[];
    const imgs = Array.from(document.querySelectorAll('.shot-img')) as HTMLElement[];
    const statusEl = document.querySelector('[data-rot-status]');
    const toggleBtn = document.querySelector('[data-rot-toggle]');
    const dotEl = document.querySelector('[data-rot-dot]') as HTMLElement | null;

    let currentIdx = 0;
    let userPaused = false;
    let hoverPaused = false;

    function syncLabel() {
      const paused = userPaused || hoverPaused;
      if (statusEl) {
        statusEl.textContent = userPaused
          ? 'Rotación en pausa · Reanudar'
          : hoverPaused
          ? 'Rotación en pausa (cursor encima)'
          : 'Rotación automática activa · Pausar';
      }
      if (dotEl) {
        dotEl.style.background = paused ? '#94a3b8' : '#22c55e';
      }
    }

    function activate(idx: number) {
      currentIdx = (idx + tabs.length) % tabs.length;
      const btn = tabs[currentIdx];
      const id = btn.getAttribute('data-shot');
      const col = btn.getAttribute('data-color') || '#2563eb';

      tabs.forEach((t, i) => {
        const on = i === currentIdx;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.style.background = on ? col : '';
        t.style.color = on ? '#ffffff' : '';
      });

      imgs.forEach((img) => {
        img.classList.toggle('active', img.getAttribute('data-panel') === id);
      });
    }

    tabs.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        activate(idx);
      });
    });

    toggleBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      syncLabel();
    });

    showcase?.addEventListener('mouseenter', () => {
      hoverPaused = true;
      syncLabel();
    });

    showcase?.addEventListener('mouseleave', () => {
      hoverPaused = false;
      syncLabel();
    });

    window.setInterval(() => {
      if (!userPaused && !hoverPaused && tabs.length > 1) {
        activate(currentIdx + 1);
      }
    }, 4500);
  </script>
</Layout>

<style>
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.02em;
  }

  .brand-icon {
    border-radius: 8px;
  }

  .exp-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.14s ease, background 0.14s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-lg {
    padding: 13px 22px;
    font-size: 15px;
    border-radius: 11px;
  }

  .btn-primary {
    background: var(--blue);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-outline {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: var(--ink);
  }

  .btn-dark {
    background: #0f172a;
    color: #ffffff;
  }

  .hero {
    padding: 64px 0 56px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, #dbeafe 0%, var(--bg) 56%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1d4ed8;
    font-size: 12px;
    font-weight: 700;
  }

  .pill-badge.warn {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }

  .pill-badge.neutral {
    background: #ffffff;
    border-color: var(--border);
    color: var(--muted);
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 860px;
  }

  .hero-sub {
    margin: 0 0 26px;
    font-size: 16.5px;
    color: var(--muted);
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .origin-note {
    margin: 0 0 34px;
    font-size: 13.5px;
    color: var(--faint);
    max-width: 720px;
  }

  .origin-note a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .showcase {
    width: 100%;
    max-width: 980px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .shot-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
    background: #ffffff;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
  }

  .shot-tab {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .shot-tab:hover:not(.active) {
    background: #f1f5f9;
    color: var(--ink);
  }

  .autoplay-bar {
    display: flex;
    justify-content: center;
  }

  .autoplay-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.85);
    color: var(--faint);
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.14s ease, border-color 0.14s ease;
  }

  .autoplay-btn:hover {
    color: var(--ink);
    border-color: #cbd5e1;
  }

  .autoplay-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }

  .shot-frame {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
    overflow: hidden;
  }

  .shot-img {
    display: none;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .shot-img.active {
    display: block;
    animation: fadeIn 0.28s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0.35; }
    to { opacity: 1; }
  }

  .section {
    padding: 68px 0;
  }

  .section-alt {
    background: #ffffff;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 38px;
  }

  .section-head h2 {
    margin: 0 0 10px;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.02em;
  }

  .section-head p {
    margin: 0;
    color: var(--muted);
    font-size: 15.5px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
  }

  .feature-badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--blue);
    background: #eff6ff;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }

  .feature-card h3 {
    margin: 0 0 8px;
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .feature-card p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .initiative-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .initiative-card h2 {
    margin: 4px 0 12px;
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.02em;
  }

  .initiative-card p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 15px;
    max-width: 820px;
  }

  .initiative-card a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .exp-disclaimer {
    margin: 16px 0 0 !important;
    padding: 12px 15px;
    border-radius: 10px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e !important;
    font-size: 13.5px !important;
  }

  .download-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .download-box h2 {
    margin: 0 0 6px;
    font-size: 26px;
  }

  .download-box p {
    margin: 0;
    color: var(--muted);
    max-width: 520px;
  }

  .download-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    background: #ffffff;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13.5px;
    color: var(--muted);
  }

  .footer-inner p {
    margin: 0;
  }

  @media (max-width: 840px) {
    .nav-links {
      display: none;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

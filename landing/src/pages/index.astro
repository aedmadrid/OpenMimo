---
import Layout from '../layouts/Layout.astro';

const REPO_URL = 'https://github.com/aedmadrid/openmimo';
const RELEASES_URL = 'https://github.com/aedmadrid/openmimo/releases/latest';
const AEDM_URL = 'https://aedm.org.es';

const shots = [
  { id: 'timetables', label: 'Horarios', color: '#059669', src: '/shots/timetables.png', alt: 'Vista de Horarios interactivos de OpenMimo con huecos y mini-horarios vinculados' },
  { id: 'guides', label: 'Guías Docentes', color: '#0284c7', src: '/shots/guides.png', alt: 'Editor colaborativo de Guías Docentes con exportación a Astro' },
  { id: 'scripts', label: 'Librería de Scripts', color: '#e11d48', src: '/shots/scripts.png', alt: 'Librería de Scripts JavaScript con generación IA y consola de depuración' },
  { id: 'courses', label: 'Sesiones y Reglas', color: '#ea580c', src: '/shots/courses.png', alt: 'Gestión de sesiones con mínimo y máximo de horas seguidas' },
  { id: 'home', label: 'Inicio y Proyectos', color: '#2563eb', src: '/shots/home.png', alt: 'Pantalla de inicio con proyectos recientes, compartidos e importación Mimosa' },
];

const features = [
  {
    badge: 'Clon de Mimosa',
    title: 'Abre tus archivos antiguos de Mimosa sin perder nada',
    text: 'Mimosa desapareció y dejó de recibir mantenimiento. OpenMimo abre directamente los ficheros heredados (.mfw y .mxt) sin límites de capacidad y los guarda en formato abierto .omimo.',
  },
  {
    badge: 'Nuevo diseño',
    title: 'Interfaz moderna, clara y sin ruido visual',
    text: 'Seis espacios de trabajo dedicados (Recursos, Sesiones, Semanas, Horarios, Guías y Scripts) con barra superior limpia, menú contextual propio y menús nativos.',
  },
  {
    badge: 'MCP integrado',
    title: 'Compatible con cualquier Agente IA vía MCP',
    text: 'Servidor MCP JSON-RPC 2.0 (stdio y HTTP) con 20 herramientas para gestionar horarios, recursos, restricciones, guías docentes y scripts desde cualquier agente.',
  },
  {
    badge: 'Edición colaborativa',
    title: 'Tiempo real e IPFS para equipos y docentes',
    text: 'Comparte un proyecto con un código para que varios coordinadores o profesores editen horarios y guías docentes simultáneamente mientras el equipo anfitrión lo mantiene abierto.',
  },
  {
    badge: 'Automejora + Scripts IA',
    title: 'Optimización inteligente y automatización con tu API Key',
    text: 'Motor de automejora multi-pasada con mínimo y máximo de horas seguidas por curso, además de una librería de scripts programables o generables con tu propia API Key estilo OpenAI.',
  },
  {
    badge: 'FOSS · GNU GPLv3',
    title: 'Software libre y proyecto experimental abierto',
    text: '100 % código abierto bajo licencia GNU GPLv3, sin versiones de pago ni bloqueos. Se encuentra en desarrollo experimental activo: revisa siempre tus horarios antes de publicarlos.',
  },
];
---

<Layout
  title="OpenMimo — Clon libre de Mimosa para horarios y guías docentes"
  description="Clon libre (GNU GPLv3) y experimental de Mimosa compatible con archivos .mfw y .mxt, con nuevo diseño, MCP, edición colaborativa y guías en Astro. Iniciativa de aedm.org.es para la ESDMadrid."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" class="brand">
        <img src="/logo.svg" alt="OpenMimo" width="32" height="32" class="brand-icon" />
        <span>OpenMimo</span>
        <span class="exp-tag">Experimental</span>
      </a>
      <nav class="nav-links">
        <a href="#capturas">Capturas</a>
        <a href="#funciones">Funciones</a>
        <a href="#iniciativa">Iniciativa</a>
        <a href="#descargar">Descargar</a>
        <a href={REPO_URL} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary">
        Descargar
      </a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="badges-row">
          <span class="pill-badge">FOSS · GNU GPLv3</span>
          <span class="pill-badge warn">Software Experimental</span>
          <span class="pill-badge neutral">Compatible con .mfw y .mxt</span>
        </div>

        <h1>El sucesor libre de Mimosa<br />para horarios y guías docentes.</h1>
        <p class="hero-sub">
          Mimosa ya no existe ni se actualiza. <strong>OpenMimo</strong> es un clon moderno y de código abierto
          compatible con la apertura de archivos antiguos de Mimosa, con nuevo diseño, servidor <strong>MCP</strong>,
          <strong>edición colaborativa</strong> y guías docentes exportables a Astro.
        </p>

        <div class="hero-actions">
          <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary btn-lg">
            Descargar para macOS y Windows
          </a>
          <a href={REPO_URL} target="_blank" rel="noreferrer" class="btn btn-outline btn-lg">
            Ver repositorio en GitHub
          </a>
        </div>

        <p class="origin-note">
          Una iniciativa de <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>aedm.org.es</strong></a>
          para que la <strong>ESDMadrid</strong> pueda actualizar su software de planificación académica.
        </p>

        <!-- Real App Screenshots Interactive Showcase -->
        <div id="capturas" class="showcase">
          <div class="shot-tabs" role="tablist" aria-label="Capturas de OpenMimo">
            {shots.map((s, idx) => (
              <button
                type="button"
                class={`shot-tab ${idx === 0 ? 'active' : ''}`}
                data-shot={s.id}
                data-color={s.color}
                style={idx === 0 ? `background:${s.color};color:#fff;` : ''}
              >
                {s.label}
              </button>
            ))}
          </div>
          <div class="shot-frame">
            {shots.map((s, idx) => (
              <img
                src={s.src}
                alt={s.alt}
                data-panel={s.id}
                class={`shot-img ${idx === 0 ? 'active' : ''}`}
                loading={idx === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="funciones" class="section section-alt">
      <div class="container">
        <div class="section-head">
          <h2>Diseñado para dar continuidad y futuro a tus horarios</h2>
          <p>Conserva el flujo familiar de Mimosa mientras añade colaboración, agentes MCP, scripts y publicación web moderna.</p>
        </div>
        <div class="features-grid">
          {features.map((f) => (
            <article class="feature-card">
              <span class="feature-badge">{f.badge}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="iniciativa" class="section">
      <div class="container">
        <div class="initiative-card">
          <div>
            <span class="feature-badge">Proyecto FOSS · Experimental</span>
            <h2>Iniciativa de aedm.org.es para modernizar el software de la ESDMadrid</h2>
            <p>
              Ante la desaparición de Mimosa Scheduling Software, <strong>OpenMimo</strong> nace impulsado por{' '}
              <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>aedm.org.es</strong></a> con el objetivo de ofrecer a la{' '}
              <strong>ESDMadrid</strong> —y a cualquier centro educativo que lo necesite— una alternativa libre, moderna,
              compatible con sus archivos históricos y mantenible por la comunidad bajo licencia <strong>GNU GPLv3</strong>.
            </p>
            <p class="exp-disclaimer">
              <strong>Nota sobre el estado experimental:</strong> OpenMimo se encuentra en fase experimental activa.
              Guarda copias en formato <code>.omimo</code> y verifica los resultados antes de su publicación oficial.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="descargar" class="section section-alt">
      <div class="container">
        <div class="download-box">
          <div>
            <h2>Descarga OpenMimo</h2>
            <p>
              Instaladores para macOS y Windows con búsqueda automática de nuevas releases en GitHub.
            </p>
          </div>
          <div class="download-actions">
            <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-primary btn-lg">
              macOS (.dmg)
            </a>
            <a href={RELEASES_URL} target="_blank" rel="noreferrer" class="btn btn-dark btn-lg">
              Windows (.exe / .msi)
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="brand">
        <img src="/logo.svg" alt="OpenMimo" width="24" height="24" class="brand-icon" />
        <span>OpenMimo</span>
      </div>
      <p>
        Iniciativa de <a href={AEDM_URL} target="_blank" rel="noreferrer"><strong>aedm.org.es</strong></a> ·
        Licencia <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noreferrer"><strong>GNU GPLv3</strong></a> ·
        <a href={REPO_URL} target="_blank" rel="noreferrer">github.com/aedmadrid/openmimo</a>
      </p>
    </div>
  </footer>

  <script>
    const tabs = document.querySelectorAll('.shot-tab');
    const imgs = document.querySelectorAll('.shot-img');
    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-shot');
        const col = btn.getAttribute('data-color') || '#2563eb';
        tabs.forEach((t) => {
          t.classList.remove('active');
          (t as HTMLElement).style.background = '';
          (t as HTMLElement).style.color = '';
        });
        btn.classList.add('active');
        (btn as HTMLElement).style.background = col;
        (btn as HTMLElement).style.color = '#ffffff';
        imgs.forEach((img) => {
          img.classList.toggle('active', img.getAttribute('data-panel') === id);
        });
      });
    });
  </script>
</Layout>

<style>
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.02em;
  }

  .brand-icon {
    border-radius: 8px;
  }

  .exp-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.14s ease, background 0.14s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-lg {
    padding: 13px 22px;
    font-size: 15px;
    border-radius: 11px;
  }

  .btn-primary {
    background: var(--blue);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-outline {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: var(--ink);
  }

  .btn-dark {
    background: #0f172a;
    color: #ffffff;
  }

  .hero {
    padding: 64px 0 56px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, #dbeafe 0%, var(--bg) 56%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1d4ed8;
    font-size: 12px;
    font-weight: 700;
  }

  .pill-badge.warn {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }

  .pill-badge.neutral {
    background: #ffffff;
    border-color: var(--border);
    color: var(--muted);
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 820px;
  }

  .hero-sub {
    margin: 0 0 26px;
    font-size: 16.5px;
    color: var(--muted);
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .origin-note {
    margin: 0 0 36px;
    font-size: 13.5px;
    color: var(--faint);
  }

  .origin-note a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .showcase {
    width: 100%;
    max-width: 980px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .shot-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    background: #ffffff;
    padding: 4px;
    border-radius: 11px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  }

  .shot-tab {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.14s ease, color 0.14s ease;
  }

  .shot-tab:hover:not(.active) {
    background: #f1f5f9;
    color: var(--ink);
  }

  .shot-frame {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
    overflow: hidden;
  }

  .shot-img {
    display: none;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .shot-img.active {
    display: block;
  }

  .section {
    padding: 68px 0;
  }

  .section-alt {
    background: #ffffff;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 38px;
  }

  .section-head h2 {
    margin: 0 0 10px;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.02em;
  }

  .section-head p {
    margin: 0;
    color: var(--muted);
    font-size: 15.5px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
  }

  .feature-badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--blue);
    background: #eff6ff;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }

  .feature-card h3 {
    margin: 0 0 8px;
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .feature-card p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .initiative-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .initiative-card h2 {
    margin: 4px 0 12px;
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.02em;
  }

  .initiative-card p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 15px;
    max-width: 780px;
  }

  .initiative-card a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .exp-disclaimer {
    margin: 16px 0 0 !important;
    padding: 12px 15px;
    border-radius: 10px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e !important;
    font-size: 13.5px !important;
  }

  .download-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .download-box h2 {
    margin: 0 0 6px;
    font-size: 26px;
  }

  .download-box p {
    margin: 0;
    color: var(--muted);
    max-width: 520px;
  }

  .download-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    background: #ffffff;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13.5px;
    color: var(--muted);
  }

  .footer-inner p {
    margin: 0;
  }

  @media (max-width: 840px) {
    .nav-links {
      display: none;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

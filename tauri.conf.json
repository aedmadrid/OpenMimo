{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMimo",
  "version": "1.0.0",
  "identifier": "org.openmimo.scheduler",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/icon.png"
    ],
    "resources": {
      "backend/openmimo-backend*": "backend/"
    },
    "category": "Education",
    "shortDescription": "Horarios y guías docentes libres",
    "longDescription": "OpenMimo es una aplicación libre (GNU GPLv3) de planificación de horarios académicos y guías docentes, compatible con archivos de Mimosa (.mfw/.mxt) y con formato abierto .omimo.",
    "copyright": "GNU GPLv3 · Asociación de Estudiantes de Diseño de Madrid"
  }
}
